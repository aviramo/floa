# The shape of .env. This file is committed; .env is not.
#
# Copy it (`cp .env.example .env`), fill in the token, and nothing else needs
# to change: scripts/sql.mjs reads .env itself.
#
# SUPABASE_ACCESS_TOKEN is a personal access token from
# https://supabase.com/dashboard/account/tokens — it starts with sbp_ and is
# shown once. It is an ADMIN key: it can read every table past row level
# security, alter them and drop them. It is not the anon key in
# businesses/floa/domain/supabase.js, which is public on purpose and can barely
# do anything; and it is not a service role key, which cannot run DDL at all.
#
# The project ref is the one in that same file's URL. One Supabase project
# serves all of floa.co.il, so there is only ever one here.

SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=aexmnaxvahblveejsbup
